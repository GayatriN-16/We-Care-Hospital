{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document representing clinical patients",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Clinical appointment reserved by patients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientName": { "type": "string" },
        "patientEmail": { "type": "string" },
        "patientPhone": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "departmentId": { "type": "string" },
        "departmentName": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["confirmed", "cancelled", "completed"] },
        "createdAt": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": [
        "id",
        "patientName",
        "patientEmail",
        "patientPhone",
        "doctorId",
        "doctorName",
        "departmentId",
        "departmentName",
        "date",
        "timeSlot",
        "reason",
        "status",
        "createdAt",
        "userId"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection storing basic user profiles"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Collection storing doctor appointments"
    }
  }
}
